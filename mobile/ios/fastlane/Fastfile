# Signs the iPhone build with the one saved certificate (scripts/ios-signing-cert.mjs), and never makes one, as Apple's
# account holds only a few. Main's builds go to TestFlight and the public beta, and a release to App Store review.
require "base64"
require "shellwords"
require "tmpdir"

# The speech package looks up these functions in the app when it runs. An archive that left one out, or stripped it,
# writes no words on the phone. Runner keeps them with -Wl,-u and STRIP_STYLE = non-global in project.pbxproj.
SPEECH_PARTS = %w[_wf_run _wf_context_create _wf_job_create _wf_last_error].freeze

# Stops the lane before TestFlight when the app in the exported .ipa, or one of its frameworks, lacks a speech part.
# The export can strip the app again after the archive, so the check reads the exact file TestFlight gets.
def check_speech_parts(ipa)
  UI.user_error!("No .ipa to check for speech parts.") if ipa.nil? || !File.file?(ipa)
  Dir.mktmpdir("speech-parts") do |dir|
    UI.user_error!("Could not unzip #{ipa}.") unless system("unzip", "-q", ipa, "-d", dir)
    app = File.join(dir, "Payload", "Runner.app")
    binaries = [File.join(app, "Runner")] +
      Dir[File.join(app, "Frameworks", "*.framework")].map { |framework| File.join(framework, File.basename(framework, ".framework")) }
    found = binaries.select { |binary| File.file?(binary) }.flat_map { |binary|
      `nm -gU #{binary.shellescape} 2>/dev/null`.lines.map { |line| line.split.last }.compact
    }
    missing = SPEECH_PARTS - found
    unless missing.empty?
      UI.user_error!("The iPhone build left out speech parts: #{missing.join(' ')}. Voice notes would get no words.")
    end
  end
  UI.success("All speech parts are in the build.")
end

default_platform(:ios)

# Each signed part of the app: its Xcode target and its bundle id. The watch app and its watch face button ship inside
# the iPhone app, each with its own App Store profile.
SIGNED_TARGETS = {
  "Runner" => "com.matthewwong525.relayApp",
  "ShareExtension" => "com.matthewwong525.relayApp.share",
  "RelayWatch" => "com.matthewwong525.relayApp.watchkitapp",
  "RelayWatchWidget" => "com.matthewwong525.relayApp.watchkitapp.widget"
}.freeze

# The name Apple's account shows for a bundle id this build registers: letters, digits and spaces only.
BUNDLE_NAMES = {
  "RelayWatch" => "Relay Everything Watch",
  "RelayWatchWidget" => "Relay Everything Watch Button"
}.freeze

# App Store states in which a version is already sent: a rerun of the release job sends it no second time.
SENT_STATES = %w[
  WAITING_FOR_REVIEW IN_REVIEW ACCEPTED PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE PROCESSING_FOR_APP_STORE
  READY_FOR_SALE
].freeze

# The build's processing at Apple can take over 30 minutes. mobile-ci.yml gives the release job 90 minutes, and
# mobile-public-beta.yml gives its job 90, so the whole wait and the setup fit.
PROCESSING_WAIT = 75 * 60

# The external TestFlight group with the public link. It, its beta description and its reviewer contact are set by hand
# in App Store Connect (mobile/README.md#public-beta); the public_beta lane only adds builds.
PUBLIC_BETA_GROUP = "Public beta"

# Apple's own What to Test limit.
WHAT_TO_TEST_LIMIT = 4000

platform :ios do
  # The App Store Connect key from the secrets; it also signs Spaceship's own calls.
  private_lane :connect_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  # A profile needs its bundle id on Apple's account: the first build registers a missing one, and later builds find it.
  # Watch apps register on the iOS platform, as Apple signs them with iOS App Store profiles.
  private_lane :ensure_bundle_ids do
    SIGNED_TARGETS.each do |target, bundle_id|
      next if Spaceship::ConnectAPI::BundleId.find(bundle_id)
      UI.message("Registering the bundle id #{bundle_id} with Apple.")
      Spaceship::ConnectAPI::BundleId.create(
        name: BUNDLE_NAMES.fetch(target, "Relay Everything"),
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: bundle_id
      )
    end
  end

  # Signs, archives and exports the .ipa, then checks its speech parts. Returns the App Store Connect key.
  private_lane :build_signed do
    setup_ci
    api_key = connect_key
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # The .p12 lives only for this run, in setup_ci's own keychain.
    p12_path = File.join(Dir.tmpdir, "relay-distribution.p12")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
    begin
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
      )
    ensure
      File.delete(p12_path) if File.exist?(p12_path)
    end

    ensure_bundle_ids
    # sigh takes only the certificate in this keychain: it reuses Apple's valid profile for it, or makes one.
    profiles = SIGNED_TARGETS.to_h do |target, bundle_id|
      get_provisioning_profile(api_key: api_key, app_identifier: bundle_id, team_id: team_id)
      profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )
      [bundle_id, profile_name]
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      # A CocoaPods resource bundle can need a team; the signed targets above sign manually all the same.
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      export_options: { signingStyle: "manual", teamID: team_id, provisioningProfiles: profiles }
    )
    # The .ipa exported from the archive is the file TestFlight gets, so the check reads it, not an earlier build.
    check_speech_parts(lane_context[SharedValues::IPA_OUTPUT_PATH])
    api_key
  end

  desc "Build, sign and check, and send nothing: a branch's build"
  lane :build do
    build_signed
  end

  desc "Build, sign and upload to TestFlight: main and a release"
  lane :beta do
    api_key = build_signed
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  # fastlane submit version:1.1.0 build:120 notes:whats-new.txt [check:true]
  desc "Send an uploaded build to App Store review with only its What's New text; check:true stops before it sends"
  lane :submit do |options|
    version = options.fetch(:version).to_s
    build = options.fetch(:build).to_s
    notes = File.read(options.fetch(:notes)).strip
    check = options[:check].to_s == "true"
    api_key = connect_key
    app = connect_app

    versions = app.get_app_store_versions(filter: { platform: "IOS" })
    same = versions.find { |found| found.version_string == version }
    if same && SENT_STATES.include?(same.app_store_state)
      UI.important("Version #{version} is already #{same.app_store_state}, so it is not sent again.")
      next
    end
    # Apple takes one version in review at a time.
    busy = versions.find do |found|
      found.version_string != version && %w[WAITING_FOR_REVIEW IN_REVIEW].include?(found.app_store_state)
    end
    if busy
      UI.user_error!("Version #{busy.version_string} is still #{busy.app_store_state}. " \
                     "Run the release job again when its review ends.")
    end
    live = versions.find { |found| found.app_store_state == "READY_FOR_SALE" }
    if live && Gem::Version.new(version) <= Gem::Version.new(live.version_string)
      UI.user_error!("Version #{version} is not higher than #{live.version_string}, the version in the App Store.")
    end

    wait_for_processing(app, version, build)
    if check
      UI.success("Ready: build #{build} of #{version} is processed, and App Store review can take it. Nothing was sent.")
      next
    end

    # An empty metadata folder and only the release notes, so the listing's description, pictures and answers stay.
    # Apple refuses What's New on an app's first version, so it goes only when a version is already live.
    release_notes = live ? { release_notes: { "default" => notes } } : {}
    UI.message("The first version in the App Store: Apple takes no What's New, so none is sent.") unless live
    Dir.mktmpdir("metadata") do |metadata|
      deliver(
        api_key: api_key,
        app_identifier: app.bundle_id,
        platform: "ios",
        app_version: version,
        build_number: build,
        metadata_path: metadata,
        **release_notes,
        skip_binary_upload: true,
        skip_screenshots: true,
        submit_for_review: true,
        automatic_release: true,
        run_precheck_before_submit: false,
        submission_information: { add_id_info_uses_idfa: false },
        force: true
      )
    end
  end

  # fastlane public_beta version:1.1.1 build:271 notes:what-to-test.txt
  desc "Add a TestFlight build to the Public beta group with its What to Test text, and send it to beta review"
  lane :public_beta do |options|
    version = options.fetch(:version).to_s
    build = options.fetch(:build).to_s
    notes = File.read(options.fetch(:notes)).strip[0, WHAT_TO_TEST_LIMIT]
    connect_key
    app = connect_app

    group = app.get_beta_groups(filter: { name: PUBLIC_BETA_GROUP }).find { |found| found.name == PUBLIC_BETA_GROUP }
    if group.nil?
      UI.user_error!("App Store Connect has no TestFlight group \"#{PUBLIC_BETA_GROUP}\". " \
                     "Make it as mobile/README.md#public-beta says, then run this job again.")
    end

    # One deadline for both waits: Apple's processing, then the build's beta processing.
    deadline = Time.now + PROCESSING_WAIT
    found = wait_for_processing(app, version, build, deadline)
    write_what_to_test(found, app.primary_locale, notes)
    if group.fetch_builds.any? { |member| member.id == found.id }
      UI.message("Build #{build} of #{version} is already in #{PUBLIC_BETA_GROUP}.")
    else
      found.add_beta_groups(beta_groups: [group])
      UI.success("Build #{build} of #{version} is in #{PUBLIC_BETA_GROUP}.")
    end
    submit_beta_review(wait_for_beta_processing(found, deadline))
  end
end

# The app in App Store Connect, by the Appfile's bundle id.
def connect_app
  app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("App Store Connect has no app #{app_identifier}.") if app.nil?
  app
end

# Writes the build's What to Test for one locale, or changes it when the build already has that locale.
def write_what_to_test(build, locale, notes)
  attributes = { whatsNew: notes }
  existing = build.get_beta_build_localizations.find { |localization| localization.locale == locale }
  if existing
    Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: existing.id, attributes: attributes)
  else
    Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: attributes.merge(locale: locale))
  end
end

# Sends a build to beta review once; a build in any other unsent state fails with that state. Apple takes one build in
# beta review at a time, so a refusal for that is a notice: the next build sends again.
def submit_beta_review(build)
  label = "Build #{build.version} of #{build.app_version}"
  external = Spaceship::ConnectAPI::BuildBetaDetail::ExternalState
  # States in which the build was already sent to beta review: a rerun sends it no second time.
  sent = [
    external::WAITING_FOR_BETA_REVIEW, external::IN_BETA_REVIEW, external::BETA_APPROVED, external::BETA_REJECTED,
    external::IN_BETA_TESTING, external::READY_FOR_BETA_TESTING
  ]
  state = build.build_beta_detail&.external_build_state
  if sent.include?(state)
    UI.message("#{label} is #{state}, so it is not sent to beta review again.")
    return
  end
  unless state == external::READY_FOR_BETA_SUBMISSION
    UI.user_error!("#{label} is #{state || 'in no beta state'} in App Store Connect, so it can not go to beta review.")
  end
  begin
    build.post_beta_app_review_submission
  rescue StandardError => e
    raise unless another_build_in_review?(e.message)
    UI.important("#{label} is in #{PUBLIC_BETA_GROUP}, but Apple took no beta review: #{e.message}")
    return
  end
  UI.success("#{label} is sent to beta review.")
end

# Apple's refusal when an earlier build still waits for beta review.
def another_build_in_review?(message)
  message.match?(/another build|already (in|waiting for) (beta )?review|one build .*in review/i)
end

# Waits until Apple has processed the build, as App Store review takes only a processed build.
def wait_for_processing(app, version, build, deadline = Time.now + PROCESSING_WAIT)
  loop do
    found = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build).first
    state = found&.processing_state
    return found if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
    if %w[INVALID FAILED].include?(state)
      UI.user_error!("Build #{build} of #{version} is #{state} in App Store Connect.")
    end
    if Time.now > deadline
      UI.user_error!("Build #{build} of #{version} was not processed in time. Run the job again.")
    end
    UI.message("Build #{build} of #{version} is #{state || 'not in App Store Connect yet'}; checking again in a minute.")
    sleep(60)
  end
end

# Waits until Apple has also processed the build for TestFlight: its beta detail can still be PROCESSING after the
# build is VALID, and beta review takes only a processed build. Returns the build read again, with its beta detail.
def wait_for_beta_processing(build, deadline)
  label = "Build #{build.version} of #{build.app_version}"
  loop do
    found = Spaceship::ConnectAPI::Build.get(build_id: build.id)
    detail = found.build_beta_detail
    return found if detail&.processed?
    if Time.now > deadline
      UI.user_error!("#{label} was not processed for TestFlight in time. Run the job again.")
    end
    UI.message("#{label} is #{detail&.external_build_state || 'with no beta state yet'} for TestFlight; " \
               "checking again in a minute.")
    sleep(60)
  end
end
