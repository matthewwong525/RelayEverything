<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later show the app icon on this color while the app starts: the brand's light paper, in light
         and dark mode, as on launch_background.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_paper</item>
    </style>
</resources>
