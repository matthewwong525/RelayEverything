// The spaces Worker of a Relay Everything install: one Durable Object per person, as in app/wrangler.spaces.jsonc.
// setup.mjs fills in its own names and writes app/self-host/wrangler.spaces.jsonc, which git ignores.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "relay-spaces",
  "main": "../worker/spaces-worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
  "workers_dev": false,
  "preview_urls": false,
  // Each space runs schema/space-migrations/*.sql, which the Worker takes in as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "SPACES", "class_name": "Space" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Space"] }],
  "queues": { "producers": [{ "binding": "RELAY_WEBHOOKS", "queue": "relay-webhooks" }] }
}
