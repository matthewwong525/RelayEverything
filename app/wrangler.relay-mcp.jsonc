// Relay Everything's AI connector: its own Worker on its own workers.dev address. AI apps sign in through the server's
// own sign-in, each grant reads one person's space, and OAUTH_KV keeps grants. wiki/stack/relay-ai-connector.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-everything-mcp",
  "main": "worker/relay-mcp/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
  "workers_dev": true,
  "preview_urls": false,
  // The connector has no secret: a person signs in on RELAY_SERVER_URL, which sends a one-time code to /callback.
  "vars": {
    "RELAY_MCP_ADDRESS": "https://relay-everything-mcp.matthewwong525.workers.dev/mcp",
    "RELAY_SERVER_URL": "https://app.relayeverything.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "relay-everything-db", "database_id": "9f8aa624-0d1c-4abf-902a-7b9430286378" }],
  "durable_objects": { "bindings": [{ "name": "SPACES", "class_name": "Space", "script_name": "relay-everything-spaces" }] },
  // No id: the first deploy, which the setup script runs, makes the store, and later deploys keep it.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "env": {
    "staging": {
      "name": "relay-everything-mcp-staging",
      "vars": {
        "RELAY_MCP_ADDRESS": "https://relay-everything-mcp-staging.matthewwong525.workers.dev/mcp",
        "RELAY_SERVER_URL": "https://app-staging.relayeverything.com"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "relay-everything-db-staging", "database_id": "4f8edf18-ad51-4325-bb98-ec3ca6cc80b0" }],
      "durable_objects": { "bindings": [{ "name": "SPACES", "class_name": "Space", "script_name": "relay-everything-spaces-staging" }] },
      "kv_namespaces": [{ "binding": "OAUTH_KV" }]
    }
  }
}
