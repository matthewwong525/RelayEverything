{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-everything",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-28",
  // disallow_importable_env: code gets a binding only from its route's env,
  // and a mini app's env lacks the memory store, so it can't import it.
  "compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
  // Signed Access identity is checked before every page, asset, API, and mini app.
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": {
    "WONG_KEY_SEAL_PUBLIC": "",
    "WONG_ENVIRONMENT": "production",
    "WONG_KNOWLEDGE_REPOSITORY": "relay-everything-knowledge",
    "WONG_CODE_REPOSITORY": "matthewwong525/RelayEverything",
    "WONG_OWNER_EMAIL": "matthewwong525@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "startuptemplate.cloudflareaccess.com",
    "CF_ACCESS_AUD": "76b579e034cfc7891c67bff9c593e31d2d8dc0b4b5548427d5257a5893ba9879",
    "CF_ACCESS_APP_ID": "f938f676-4c71-445d-bacb-3649b4897276",
    "CF_ACCESS_WORKER_ID": "3994b8ff29ac409dbfe1783049f21864",
    // The live checker's Client ID, which names its service token and opens nothing alone. Relay Everything
    // refuses every other service token: app/worker/apps/relay/caller.ts
    "RELAY_CHECKER_SHA256": "cc48186f16567a1acbcdabbbdce1446b905f77fd265a4e9f79865d1adb9930a1"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "relay-everything-db", "database_id": "9f8aa624-0d1c-4abf-902a-7b9430286378", "migrations_dir": "../schema/migrations" },
    // Session memory, production only. No migrations_dir: the memory skill migrates it.
    { "binding": "MEMORY_DB", "database_name": "relay-everything-memory", "database_id": "43757596-8f32-498f-875a-21a2e4108002" }
  ],
  // MEMORY_BUCKET only when the memory store has a bucket. RELAY_BUCKET keeps the ring notes' recordings.
  "r2_buckets": [
    { "binding": "MEMORY_BUCKET", "bucket_name": "relay-everything-memory" },
    { "binding": "RELAY_BUCKET", "bucket_name": "relay-everything-notes" }
  ],
  // Relay Everything's webhooks: a message says "look now" for one person's webhook; the space holds what was sent.
  // app/worker/apps/relay/webhooks/send.ts
  "queues": {
    "producers": [{ "binding": "RELAY_WEBHOOKS", "queue": "relay-everything-webhooks" }],
    "consumers": [{ "queue": "relay-everything-webhooks", "max_batch_size": 10, "max_retries": 10 }]
  },
  // Rereads who can push on GitHub, for previews' sign-in.
  "triggers": { "crons": ["*/15 * * * *"] },
  // The private site's own address; the workers.dev address stays on for Access. Staging has none.
  // app.relayeverything.com is the shared server's: wrangler.relay.jsonc.
  "routes": [{ "pattern": "admin.relayeverything.com", "custom_domain": true }],
  // With routes, Wrangler turns workers.dev off unless this says true, and Access returns each sign-in there.
  "workers_dev": true,
  // SPACES: each Relay Everything person's own space, in its own Worker (wrangler.spaces.jsonc), which deploys first.
  "durable_objects": { "bindings": [{ "name": "LIVE_LINE", "class_name": "Line", "script_name": "relay-everything-line" },
    { "name": "SPACES", "class_name": "Space", "script_name": "relay-everything-spaces" },
    { "name": "WORKBENCHES", "class_name": "Workbench", "script_name": "relay-everything-spaces" }] },
  "migrations": [{ "tag": "line-1", "new_sqlite_classes": ["Line"] }, { "tag": "line-2", "deleted_classes": ["Line"] }],
  // The project's own repository, which Connect your assistant hands out. wiki/stack/employee-project.md
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "wongstack" }],
  // The AI connector's list of connected AI apps, for the Relay page: app/worker/relay-mcp/index.ts. Its Worker must
  // exist before this one deploys: scripts/relay-mcp-setup.mjs makes it, and scripts/cf-deploy.sh deploys it first.
  "services": [{ "binding": "RELAY_MCP", "service": "relay-everything-mcp", "entrypoint": "Grants" }],
  "env": {
    "staging": {
      "name": "relay-everything-staging",
      "vars": {
        "WONG_KEY_SEAL_PUBLIC": "",
        "WONG_ENVIRONMENT": "staging",
        "WONG_KNOWLEDGE_REPOSITORY": "relay-everything-knowledge",
        "WONG_CODE_REPOSITORY": "matthewwong525/RelayEverything",
        "WONG_OWNER_EMAIL": "matthewwong525@gmail.com",
        "CF_ACCESS_TEAM_DOMAIN": "startuptemplate.cloudflareaccess.com",
        "CF_ACCESS_AUD": "ee3b42931ecd17ee1ef8f1355d6524f27d7abb522ffa2087d9c5f8f31dadce42",
        "CF_ACCESS_APP_ID": "8cff403b-fb55-4954-b0c8-5df2cb344722",
        "CF_ACCESS_WORKER_ID": "21a6605b2bbf465b94f3da684f303350",
        // The preview checker's Client ID.
        "RELAY_CHECKER_SHA256": "449f8b9af84a6d785f1c6a637559764baf7cdb230c4e99ae72d78dd8f33b12c2"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "relay-everything-db-staging", "database_id": "4f8edf18-ad51-4325-bb98-ec3ca6cc80b0", "migrations_dir": "../schema/migrations" }],
      "r2_buckets": [{ "binding": "RELAY_BUCKET", "bucket_name": "relay-everything-notes-staging" }],
      // Previews reach no other Worker's objects (wiki/stack/live-line.md), so staging has no SPACES: the staging
      // shared server, wrangler.relay.jsonc, holds the spaces and its own queue.
      "queues": {
        "producers": [{ "binding": "RELAY_WEBHOOKS", "queue": "relay-everything-webhooks-staging" }],
        "consumers": [{ "queue": "relay-everything-webhooks-staging", "max_batch_size": 10, "max_retries": 10 }]
      },
      "services": [{ "binding": "RELAY_MCP", "service": "relay-everything-mcp-staging", "entrypoint": "Grants" }],
      "routes": [],
      "triggers": { "crons": [] }
    },
    "local": {
      "name": "relay-everything-local",
      "vars": { "WONG_KEY_SEAL_PUBLIC": "", "WONG_ENVIRONMENT": "local", "SKIP_AUTH": "true" },
      "d1_databases": [{ "binding": "DB", "database_name": "relay-everything-db-local", "database_id": "9f8aa624-0d1c-4abf-902a-7b9430286378", "remote": false, "migrations_dir": "../schema/migrations" }],
      "r2_buckets": [{ "binding": "RELAY_BUCKET", "bucket_name": "relay-everything-notes-local", "remote": false }],
      "queues": {
        "producers": [{ "binding": "RELAY_WEBHOOKS", "queue": "relay-everything-webhooks-local" }],
        "consumers": [{ "queue": "relay-everything-webhooks-local", "max_batch_size": 10, "max_retries": 10 }]
      },
      "durable_objects": { "bindings": [{ "name": "LIVE_LINE", "class_name": "Line", "script_name": "relay-everything-line-local" },
        { "name": "SPACES", "class_name": "Space", "script_name": "relay-everything-spaces-local" },
        { "name": "WORKBENCHES", "class_name": "Workbench", "script_name": "relay-everything-spaces-local" }] }
    }
  }
}
