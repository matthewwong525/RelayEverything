{
	"name": "relay-everything-checks",
	"account_id": "040f88e2bf4f25fb0b91b7cb24f3d442",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "wongstack" }],
	"containers": [
		{ "name": "relay-everything-checks", "class_name": "CiSandbox", "image": "docker.io/cloudflare/sandbox:0.12.5", "max_instances": 2, "instance_type": "standard-4" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SANDBOX", "class_name": "CiSandbox" },
			{ "name": "TURNS", "class_name": "Turns" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["CiSandbox", "Turns"] }],
	"workflows": [{ "name": "relay-everything-checks", "binding": "CI_WORKFLOW", "class_name": "Checks" }],
	"r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "relay-everything-checks" }],
	"vars": {
		"WONG_RUNNER": "{\"account\":\"040f88e2bf4f25fb0b91b7cb24f3d442\",\"namespace\":\"wongstack\",\"repo\":\"relay-everything\"}",
		"CLOUDFLARE_ACCOUNT_ID": "040f88e2bf4f25fb0b91b7cb24f3d442",
		"BACKUP_BUCKET_NAME": "relay-everything-checks"
	},
	"triggers": {
		"events": [
			{
				"type": "cf.artifacts.repo.pushed",
				"filter": { "namespace": "wongstack", "repo_name": "relay-everything" },
				"targets": [{ "type": "workflow", "workflow_name": "relay-everything-checks" }]
			}
		]
	},
	"observability": { "enabled": true }
}
