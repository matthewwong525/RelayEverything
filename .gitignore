.DS_Store
*.log
node_modules/
# Per-machine agent settings. `.claude` links to `.agents`, and git does not resolve a path through a link.
.agents/settings.local.json

# Real secrets: the committed templates are the .example files. Never commit filled-in values.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Agents' throwaway files.
.scratch/

# The Relay website's build output and caches: site/ rebuilds them.
site/dist/
site/.astro/
site/node_modules/
site/.wrangler/

# A Relay-only install's own settings and Cloudflare key: app/self-host/setup.mjs writes them, per person.
app/self-host/wrangler.jsonc
app/self-host/wrangler.mcp.jsonc
app/self-host/wrangler.spaces.jsonc
# An install made before the tool moved into app/ keeps them here until its next run of setup.mjs moves them.
/self-host/
app/dist-relay/
# The Relay Everything page, the phone app built for the web: scripts/build-relay-web.mjs or a self-host's setup.mjs
# puts it here.
app/public/apps/relay/
